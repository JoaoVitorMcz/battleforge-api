# Copy to .env and adjust. Never commit .env.

# --- Database ---
POSTGRES_DB=battleforge
POSTGRES_USER=battleforge
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the prod profile only (full JDBC URL).
DATABASE_URL=jdbc:postgresql://postgres:5432/battleforge

# --- Application ---
SPRING_PROFILES_ACTIVE=dev

# --- Authentication (phase 4) ---
# HS256 secret, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Observability (phase 7, prod only) ---
SENTRY_DSN=
